{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "validation",
    "global",
    "runtime",
    "persistence",
    "externalDB",
    "core",
    "api",
    "ui",
    "ingress",
    "networkPolicy",
    "databaseTLS"
  ],
  "properties": {
    "validation": {
      "type": "object",
      "required": [
        "strict"
      ],
      "properties": {
        "strict": {
          "type": "boolean"
        }
      }
    },
    "global": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "registry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "propertiesSecret",
        "rabbitmqSecret"
      ],
      "properties": {
        "propertiesSecret": {
          "type": "object",
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string"
            }
          }
        },
        "rabbitmqSecret": {
          "type": "object",
          "required": [
            "name",
            "usernameKey",
            "passwordKey"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "usernameKey": {
              "type": "string",
              "minLength": 1
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "storageClass": {
          "type": "string"
        }
      }
    },
    "externalDB": {
      "type": "object",
      "required": [
        "pgHost",
        "pgPort",
        "pgCIDR",
        "rabbitHost",
        "rabbitPort",
        "rabbitCIDR",
        "searchHost",
        "searchPort",
        "searchCIDR",
        "searchTransportPort"
      ],
      "properties": {
        "pgHost": {
          "type": "string"
        },
        "pgCIDR": {
          "type": "string"
        },
        "rabbitHost": {
          "type": "string"
        },
        "rabbitCIDR": {
          "type": "string"
        },
        "searchHost": {
          "type": "string"
        },
        "searchCIDR": {
          "type": "string"
        },
        "pgPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "rabbitPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "searchPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "searchTransportPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "tlsSecretName": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backendAdditionalEgress": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cidr",
              "ports"
            ],
            "properties": {
              "cidr": {
                "type": "string",
                "minLength": 1
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "namespace": {
          "type": "string"
        },
        "podSelector": {
          "type": "object"
        }
      }
    },
    "core": {
      "$ref": "#/definitions/component"
    },
    "api": {
      "$ref": "#/definitions/component"
    },
    "ui": {
      "$ref": "#/definitions/component"
    },
    "databaseTLS": {
      "type": "object",
      "required": [
        "enabled",
        "mode",
        "secretName",
        "key",
        "mountPath"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "verify-full",
            "verify-ca"
          ]
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_./-]+$"
        }
      }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "required": [
        "replicaCount",
        "image",
        "resources",
        "nodeSelector",
        "probes"
      ],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "digest",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array"
        },
        "probes": {
          "type": "object"
        },
        "javaOptions": {
          "type": "string"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingClaim": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "mountPath": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    }
  }
}
